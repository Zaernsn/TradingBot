FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ENV VITE_API_URL=/
RUN npm run build

FROM caddy:2-alpine
ARG VCS_REF=unknown
ARG VERSION=dev
LABEL org.opencontainers.image.title="Trading Bot Web" \
      org.opencontainers.image.description="Production web application and HTTPS reverse proxy for Trading Bot" \
      org.opencontainers.image.version="$VERSION" \
      org.opencontainers.image.revision="$VCS_REF" \
      org.opencontainers.image.source="https://github.com/Zaernsn/TradingBot"
COPY --from=build /app/dist /srv
COPY Caddyfile /etc/caddy/Caddyfile
