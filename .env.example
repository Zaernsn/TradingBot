# === Application ===
APP_NAME="AI Trading Bot"
SECRET_KEY=change-me-to-a-long-random-string-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# === Database ===
DATABASE_URL=postgresql://trader:traderpass@localhost:5432/tradingbot

# === Trading Mode Safety ===
# LIVE trading is DISABLED by default. Set to "true" only after reading docs.
ENABLE_LIVE_TRADING=false

# === Exchange Credentials (NEVER commit the real .env) ===
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# === Default Trading Settings ===
DEFAULT_PAPER_BALANCE_EUR=500.00
DEFAULT_TRADING_PAIR=BTC/EUR
DEFAULT_MAX_POSITION_PCT=0.20
DEFAULT_STOP_LOSS_PCT=0.03
DEFAULT_TAKE_PROFIT_PCT=0.06
DEFAULT_FEE_PCT=0.0026

# === Frontend ===
VITE_API_URL=http://localhost:8000
