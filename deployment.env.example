APP_HOST=bot.example.com
APP_PUBLIC_URL=https://bot.example.com
# Prefer an immutable sha-* or version tag produced by the release workflow.
APP_IMAGE=ghcr.io/zaernsn/trading-bot:sha-replace-with-commit
SECRET_KEY=replace-with-at-least-64-random-hex-characters
KRAKEN_ENCRYPTION_KEY=replace-with-another-long-random-secret
ENABLE_LIVE_TRADING=false

# Resend HTTP API (required for password resets; verified sender domain)
RESEND_API_KEY=
RESEND_FROM=
